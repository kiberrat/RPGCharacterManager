<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Макросы: последовательности действий, которые запускает человек.

    Собственного движка у подсистемы нет. Условия проверяет и действия выполняет
    тот же движок правил, поэтому обработчик действия, добавленный на будущем
    этапе, становится доступен и правилам, и макросам.
  -->

  <PropertyGroup>
    <RootNamespace>RPGCharacterManager.Macros</RootNamespace>
    <Description>Макросы: последовательности действий, условия и горячие клавиши.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RPGCharacterManager.Core\RPGCharacterManager.Core.csproj" />
    <ProjectReference Include="..\RPGCharacterManager.Database\RPGCharacterManager.Database.csproj" />
    <ProjectReference Include="..\RPGCharacterManager.GameRules\RPGCharacterManager.GameRules.csproj" />
    <ProjectReference Include="..\RPGCharacterManager.Shared\RPGCharacterManager.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
