<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RPGCharacterManager.UI.ViewModels.Documents"
             xmlns:charactersVm="clr-namespace:RPGCharacterManager.UI.ViewModels.Characters"
             xmlns:contentVm="clr-namespace:RPGCharacterManager.UI.ViewModels.Content"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="RPGCharacterManager.UI.Views.Characters.SpellsPanelView"
             x:DataType="charactersVm:SheetPanelViewModel">

  <!-- книга заклинаний. -->
  <Panel DataContext="{Binding Sheet}" x:DataType="vm:CharacterSheetViewModel">
  <!--
    Раздел собран отдельной моделью представления: у книги заклинаний
    собственные поиск, пределы и действия, не связанные с остальным листом.
  -->
  <ContentControl Content="{Binding Spellbook}" Margin="0,10,0,0" />
  </Panel>
</UserControl>
