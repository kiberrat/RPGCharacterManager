<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RPGCharacterManager.UI.ViewModels.Documents"
             xmlns:charactersVm="clr-namespace:RPGCharacterManager.UI.ViewModels.Characters"
             xmlns:contentVm="clr-namespace:RPGCharacterManager.UI.ViewModels.Content"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="RPGCharacterManager.UI.Views.Characters.TraitsPanelView"
             x:DataType="charactersVm:SheetPanelViewModel">

  <!-- черты и способности. -->
  <Panel DataContext="{Binding Sheet}" x:DataType="vm:CharacterSheetViewModel">
  <DockPanel Margin="0,10,0,0">

    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
      <Button Content="Добавить черту"
              Command="{Binding ToggleTraitPickerCommand}"
              HorizontalAlignment="Left" />

      <Border Classes="Карточка" IsVisible="{Binding IsTraitPickerOpen}">
        <StackPanel Spacing="8">
          <TextBox Watermark="Поиск по названию" Text="{Binding TraitSearch}" />
          <ListBox ItemsSource="{Binding AvailableTraits}"
                   SelectedItem="{Binding SelectedAvailableTrait}"
                   MaxHeight="220"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="charactersVm:CharacterOptionViewModel">
                <StackPanel Spacing="2" Margin="2">
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Description}"
                             Classes="Вторичный"
                             TextWrapping="Wrap"
                             MaxLines="2"
                             TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding HasDescription}" />
                  <TextBlock Text="{Binding UnavailableReason}"
                             IsVisible="{Binding HasUnavailableReason}"
                             Foreground="{DynamicResource AppWarningBrush}"
                             TextWrapping="Wrap"
                             FontSize="{DynamicResource AppFontSizeSmall}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Content="Добавить выбранную"
                  Command="{Binding AddTraitCommand}"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">

        <Border Classes="Карточка">
          <StackPanel Spacing="10">
            <TextBlock Text="Черты" Classes="Подзаголовок" />

            <TextBlock Classes="Вторичный" TextWrapping="Wrap"
                       IsVisible="{Binding HasNoTraits}"
                       Text="У персонажа нет черт. Нажмите «Добавить черту»." />

            <ItemsControl ItemsSource="{Binding Traits}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="charactersVm:SheetTraitRowViewModel">
                  <Grid ColumnDefinitions="*,Auto,100,Auto" Margin="0,4">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,10,0">
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Description}"
                                 Classes="Вторичный"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HasDescription}" />
                      <TextBlock Text="{Binding Hint}" Classes="Вторичный" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding UnavailableReason}"
                                 IsVisible="{Binding HasUnavailableReason}"
                                 Foreground="{DynamicResource AppWarningBrush}"
                                 TextWrapping="Wrap"
                                 FontSize="{DynamicResource AppFontSizeSmall}" />
                    </StackPanel>

                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding IsActive}"
                                  OnContent="активна"
                                  OffContent="отключена"
                                  VerticalAlignment="Center" />

                    <TextBox Grid.Column="2"
                             Text="{Binding UsesText}"
                             Margin="8,0"
                             Watermark="использований"
                             VerticalAlignment="Center" />

                    <Button Grid.Column="3"
                            Content="Убрать"
                            VerticalAlignment="Center"
                            Command="{Binding $parent[UserControl].((charactersVm:SheetPanelViewModel)DataContext).Sheet.RemoveTraitCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="Карточка">
          <StackPanel Spacing="10">
            <TextBlock Text="Способности" Classes="Подзаголовок" />

            <TextBlock Classes="Вторичный" TextWrapping="Wrap"
                       Text="Классовые способности появляются автоматически при достижении нужного уровня. Здесь же можно создать способность только для этого персонажа." />

            <Button Content="Добавить авторскую способность"
                    Command="{Binding ToggleCustomAbilityEditorCommand}"
                    HorizontalAlignment="Left" />

            <Border Classes="Карточка" IsVisible="{Binding IsCustomAbilityEditorOpen}">
              <StackPanel Spacing="8">
                <TextBlock Text="Новая авторская способность" Classes="Подзаголовок" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <TextBox Grid.Column="0" Watermark="Название *" Text="{Binding NewAbilityName}" />
                  <TextBox Grid.Column="1" Watermark="Категория" Text="{Binding NewAbilityCategory}" />
                </Grid>
                <TextBox Watermark="Описание"
                         Text="{Binding NewAbilityDescription}"
                         AcceptsReturn="True"
                         MinHeight="80"
                         TextWrapping="Wrap" />
                <TextBox Watermark="Формула эффекта (необязательно), например: 1к8 + харизма"
                         Text="{Binding NewAbilityFormula}" />
                <Grid ColumnDefinitions="220,*" ColumnSpacing="8">
                  <ComboBox Grid.Column="0"
                            ItemsSource="{Binding AbilityDependencyOptions}"
                            SelectedItem="{Binding NewAbilityDependency}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:AbilityDependencyOption">
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBox Grid.Column="1"
                           Watermark="Значение зависимости"
                           Text="{Binding NewAbilityDependencyValue}"
                           IsVisible="{Binding IsAbilityDependencyValueVisible}" />
                </Grid>
                <TextBlock Text="{Binding AbilityDependencyHint}"
                           Classes="Вторичный"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Сохранить способность"
                          Command="{Binding CreateCustomAbilityCommand}" />
                  <Button Content="Отмена"
                          Command="{Binding ToggleCustomAbilityEditorCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock Classes="Вторичный" TextWrapping="Wrap"
                       IsVisible="{Binding HasNoAbilities}"
                       Text="Доступных способностей нет." />

            <ItemsControl ItemsSource="{Binding AbilityGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="charactersVm:SheetAbilityGroupViewModel">
                  <StackPanel Spacing="4" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Title}" Classes="Вторичный" />

                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="charactersVm:SheetAbilityRowViewModel">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,10,0">
                              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Description}"
                                         Classes="Вторичный"
                                         TextWrapping="Wrap"
                                         IsVisible="{Binding HasDescription}" />
                              <TextBlock Text="{Binding DependencyDescription}"
                                         Classes="Вторичный"
                                         TextWrapping="Wrap"
                                         IsVisible="{Binding HasDependencyDescription}" />
                              <TextBlock Text="{Binding UnavailableReason}"
                                         Foreground="{DynamicResource AppWarningBrush}"
                                         TextWrapping="Wrap"
                                         IsVisible="{Binding HasUnavailableReason}" />
                              <TextBlock Text="{Binding Hint}"
                                         Classes="Вторичный"
                                         TextWrapping="Wrap"
                                         IsVisible="{Binding HasHint}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Удалить"
                                    VerticalAlignment="Top"
                                    IsVisible="{Binding IsCustom}"
                                    Command="{Binding $parent[UserControl].((charactersVm:SheetPanelViewModel)DataContext).Sheet.DeleteCustomAbilityCommand}"
                                    CommandParameter="{Binding}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
  </Panel>
</UserControl>
