<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RPGCharacterManager.UI.ViewModels.Documents"
             xmlns:charactersVm="clr-namespace:RPGCharacterManager.UI.ViewModels.Characters"
             xmlns:contentVm="clr-namespace:RPGCharacterManager.UI.ViewModels.Content"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="RPGCharacterManager.UI.Views.Characters.RestPanelView"
             x:DataType="charactersVm:SheetPanelViewModel">

  <!-- отдых и восстановление ресурсов. -->
  <Panel DataContext="{Binding Sheet}" x:DataType="vm:CharacterSheetViewModel">
  <!--
    Отдых стоит рядом с эффектами: он восстанавливает ресурсы и проводит
    время, от которого зависят их сроки.
  -->
  <ContentControl Content="{Binding Rest}" Margin="0,10,0,0" />
  </Panel>
</UserControl>
