<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RPGCharacterManager.UI.ViewModels.Documents"
             xmlns:charactersVm="clr-namespace:RPGCharacterManager.UI.ViewModels.Characters"
             xmlns:contentVm="clr-namespace:RPGCharacterManager.UI.ViewModels.Content"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="RPGCharacterManager.UI.Views.Characters.WeaponsPanelView"
             x:DataType="charactersVm:SheetPanelViewModel">

  <!-- оружие и атаки. -->
  <Panel DataContext="{Binding Sheet}" x:DataType="vm:CharacterSheetViewModel">
  <DockPanel Margin="0,10,0,0">

    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
      <WrapPanel Orientation="Horizontal">
        <Button Content="Выдать оружие" Command="{Binding ToggleWeaponPickerCommand}" Margin="0,0,6,6" />
        <Button Content="Создать оружие" Command="{Binding ToggleLocalWeaponEditorCommand}"
                Classes="Основная" Margin="0,0,6,6" />
      </WrapPanel>
      <TextBlock Classes="Вторичный" TextWrapping="Wrap"
                 Text="Оружие можно выбрать из общего каталога или создать только для этого персонажа. Формулы сразу участвуют в атаке и расчёте урона." />

      <Border Classes="Карточка" IsVisible="{Binding IsWeaponPickerOpen}">
        <StackPanel Spacing="8">
          <TextBox Watermark="Поиск по названию" Text="{Binding WeaponSearch}" />
          <ListBox ItemsSource="{Binding AvailableWeapons}"
                   SelectedItem="{Binding SelectedAvailableWeapon}"
                   MaxHeight="220"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="charactersVm:CharacterOptionViewModel">
                <StackPanel Spacing="2" Margin="2">
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding DetailsText}"
                             Classes="Вторичный"
                             TextWrapping="Wrap"
                             IsVisible="{Binding HasDetails}" />
                  <TextBlock Text="{Binding UnavailableReason}"
                             IsVisible="{Binding HasUnavailableReason}"
                             Foreground="{DynamicResource AppWarningBrush}"
                             TextWrapping="Wrap"
                             FontSize="{DynamicResource AppFontSizeSmall}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Content="Выдать выбранное"
                  Command="{Binding AddWeaponCommand}"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Classes="Карточка" IsVisible="{Binding IsLocalWeaponEditorOpen}">
        <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock Text="Создать оружие персонажа" Classes="Подзаголовок" />
              <TextBlock Text="Оружие сохранится только у этого персонажа и сразу появится ниже."
                         Classes="Вторичный" TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto">
              <TextBox Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"
                       Text="{Binding LocalWeaponName}" Watermark="Название" />
              <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                       Text="{Binding LocalWeaponItemType}" Watermark="Тип предмета" />
              <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding LocalWeaponDescription}"
                       Watermark="Описание оружия" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
            </Grid>

            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,8">
                <TextBlock Text="Категория" Classes="Вторичный" />
                <TextBox Text="{Binding LocalWeaponCategory}" Watermark="Ближнее, дальнее…" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,8,8">
                <TextBlock Text="Дальность" Classes="Вторичный" />
                <TextBox Text="{Binding LocalWeaponRange}" Watermark="1,5 м / 18 м…" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="Тип урона" Classes="Вторичный" />
                <TextBox Text="{Binding LocalWeaponDamageType}" Watermark="Рубящий…" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="4">
                <TextBlock Text="Свойства" Classes="Вторичный" />
                <TextBox Text="{Binding LocalWeaponProperties}" Watermark="Лёгкое, двуручное, магическое…" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,8">
                <TextBlock Text="Кость попадания" Classes="Вторичный" />
                <TextBox Text="{Binding LocalWeaponAttackDiceFormula}" Watermark="1к20" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="Бонус попадания" Classes="Вторичный" />
                <TextBox Text="{Binding LocalWeaponAttackFormula}" Watermark="характеристика + бонус_мастерства" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" Margin="0,0,8,8">
                <TextBlock Text="Урон" Classes="Вторичный" />
                <TextBox Text="{Binding LocalWeaponDamageFormula}" Watermark="1к8 + характеристика" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="Критический урон" Classes="Вторичный" />
                <TextBox Text="{Binding LocalWeaponCriticalFormula}" Watermark="урон + 1к8" />
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                <TextBlock Text="Порог крита" Classes="Вторичный" />
                <NumericUpDown Value="{Binding LocalWeaponCriticalThreshold}" Minimum="1" Maximum="1000"
                               Increment="1" FormatString="0" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*">
              <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                <TextBlock Text="Характеристика" Classes="Вторичный" />
                <ComboBox ItemsSource="{Binding LocalAttributeOptions}"
                          SelectedItem="{Binding LocalWeaponScalingAttribute}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="charactersVm:LocalContentReferenceOption">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Навык владения" Classes="Вторичный" />
                <ComboBox ItemsSource="{Binding LocalSkillOptions}"
                          SelectedItem="{Binding LocalWeaponProficiencySkill}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="charactersVm:LocalContentReferenceOption">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Grid>

            <WrapPanel Orientation="Horizontal">
              <StackPanel Width="120" Spacing="4" Margin="0,0,8,8">
                <TextBlock Text="Вес" Classes="Вторичный" />
                <NumericUpDown Value="{Binding LocalWeaponWeight}" Minimum="0" Maximum="999999" Increment="0.1" FormatString="0.##" />
              </StackPanel>
              <StackPanel Width="120" Spacing="4" Margin="0,0,8,8">
                <TextBlock Text="Цена" Classes="Вторичный" />
                <NumericUpDown Value="{Binding LocalWeaponPrice}" Minimum="0" Maximum="999999999" Increment="1" FormatString="0.##" />
              </StackPanel>
              <StackPanel Width="150" Spacing="4" Margin="0,0,8,8">
                <TextBlock Text="Валюта" Classes="Вторичный" />
                <TextBox Text="{Binding LocalWeaponCurrency}" Watermark="зм" />
              </StackPanel>
            </WrapPanel>

            <Button Content="Создать и выдать" Command="{Binding CreateLocalWeaponCommand}"
                    Classes="Основная" HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">

        <TextBlock Classes="Вторичный" TextWrapping="Wrap"
                   IsVisible="{Binding HasNoWeapons}"
                   Text="У персонажа нет оружия. Выберите оружие из каталога или нажмите «Создать оружие», чтобы задать все характеристики прямо здесь." />

        <ItemsControl ItemsSource="{Binding Weapons}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="charactersVm:WeaponCardViewModel">
              <Border Classes="Карточка" Margin="0,0,0,10">
                <StackPanel Spacing="8">

                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,10,0">
                      <TextBlock Text="{Binding Name}" Classes="Подзаголовок" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Hint}"
                                 Classes="Вторичный"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HasHint}" />
                      <TextBlock Text="{Binding Description}"
                                 Classes="Вторичный"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HasDescription}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Убрать"
                            VerticalAlignment="Top"
                            Command="{Binding $parent[UserControl].((charactersVm:SheetPanelViewModel)DataContext).Sheet.RemoveWeaponCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>

                  <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Попадание" Classes="Вторичный" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AttackText}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Урон" Classes="Вторичный" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding DamageText}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding DamageType}"
                                 Classes="Вторичный"
                                 IsVisible="{Binding HasDamageType}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Критическое"
                               Classes="Вторичный" IsVisible="{Binding HasCritical}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CriticalText}"
                               TextWrapping="Wrap" IsVisible="{Binding HasCritical}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Свойства"
                               Classes="Вторичный" IsVisible="{Binding HasProperties}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PropertiesText}"
                               TextWrapping="Wrap" IsVisible="{Binding HasProperties}" />
                  </Grid>

                  <TextBlock Text="{Binding ScalingText}"
                             Classes="Вторичный"
                             TextWrapping="Wrap"
                             IsVisible="{Binding HasScaling}" />

                  <StackPanel Spacing="6" IsVisible="{Binding UsesAmmunition}">
                    <TextBlock Text="{Binding AmmunitionText}" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Запас" Classes="Вторичный" VerticalAlignment="Center" />
                      <TextBox Text="{Binding ReserveText}" Width="90" />
                      <Button Content="Записать"
                              Command="{Binding $parent[UserControl].((charactersVm:SheetPanelViewModel)DataContext).Sheet.SaveAmmunitionReserveCommand}"
                              CommandParameter="{Binding}" />
                      <TextBlock Text="{Binding ReloadTime}"
                                 Classes="Вторичный"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding HasMagazine}" />
                    </StackPanel>
                  </StackPanel>

                  <TextBlock Text="{Binding UnavailableReason}"
                             IsVisible="{Binding HasUnavailableReason}"
                             Foreground="{DynamicResource AppWarningBrush}"
                             TextWrapping="Wrap" />

                  <TextBlock Text="{Binding IssuesText}"
                             IsVisible="{Binding HasIssues}"
                             Foreground="{DynamicResource AppDangerBrush}"
                             TextWrapping="Wrap"
                             FontSize="{DynamicResource AppFontSizeSmall}" />

                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Атака"
                            IsEnabled="{Binding CanAttack}"
                            Classes="Основная"
                            Command="{Binding $parent[UserControl].((charactersVm:SheetPanelViewModel)DataContext).Sheet.AttackCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="Перезарядить"
                            IsVisible="{Binding HasMagazine}"
                            Command="{Binding $parent[UserControl].((charactersVm:SheetPanelViewModel)DataContext).Sheet.ReloadWeaponCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>

                  <Border IsVisible="{Binding HasLastResult}"
                          Background="{DynamicResource AppSurfaceBrush}"
                          CornerRadius="{DynamicResource AppCornerRadius}"
                          Padding="8">
                    <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" />
                  </Border>

                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
  </Panel>
</UserControl>
