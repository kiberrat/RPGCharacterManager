<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RPGCharacterManager.UI.ViewModels.Characters"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="700"
             x:Class="RPGCharacterManager.UI.Views.Characters.RestView"
             x:DataType="vm:RestViewModel">

  <DockPanel>

    <!-- ===================== Отчёт ===================== -->
    <Border DockPanel.Dock="Bottom"
            Classes="Подсказка"
            Margin="0,10,0,0"
            IsVisible="{Binding HasReport}">
      <TextBlock Text="{Binding LastReport}" Classes="Вторичный" TextWrapping="Wrap" />
    </Border>

    <Grid ColumnDefinitions="*,10,360">

      <!-- ===================== Виды отдыха ===================== -->
      <DockPanel Grid.Column="0">

        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
          <TextBlock Classes="Вторичный"
                     TextWrapping="Wrap"
                     Text="Виды отдыха создаются в разделе «Контент». Приложение не знает ни короткого, ни длительного отдыха: у каждого свой список восстановлений и своя длительность." />

          <Button Content="Отдохнуть"
                  Classes="Основная"
                  HorizontalAlignment="Left"
                  IsEnabled="{Binding CanRest}"
                  Command="{Binding RestCommand}" />
        </StackPanel>

        <Border Classes="Карточка" Padding="0">
          <Panel>
            <StackPanel IsVisible="{Binding IsEmpty}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="6"
                        Margin="16">
              <TextBlock Text="Видов отдыха нет" Classes="Подзаголовок" HorizontalAlignment="Center" />
              <TextBlock Classes="Вторичный"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         MaxWidth="420"
                         Text="Создайте вид отдыха в разделе «Контент» → «Виды отдыха»: укажите длительность и то, что он восстанавливает." />
            </StackPanel>

            <ListBox ItemsSource="{Binding Options}"
                     SelectedItem="{Binding SelectedRest}"
                     IsVisible="{Binding !IsEmpty}"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RestOptionViewModel">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,10,0">
                      <TextBlock Text="{Binding Name}"
                                 TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding UnavailableReason}"
                                 Classes="Вторичный"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HasUnavailableReason}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Duration}"
                               Classes="Значение"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        </Border>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="4" Background="Transparent" ResizeDirection="Columns" />

      <!-- ===================== Что восстановит ===================== -->
      <Border Grid.Column="2" Classes="Карточка">
        <Panel>
          <TextBlock Classes="Вторичный"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"
                     TextAlignment="Center"
                     IsVisible="{Binding !HasSelection}"
                     Text="Выберите вид отдыха, чтобы увидеть, что он восстановит." />

          <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="10"
                        DataContext="{Binding SelectedRest}"
                        x:DataType="vm:RestOptionViewModel">

              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Name}" Classes="Подзаголовок" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Duration}" Classes="Вторичный" />
              </StackPanel>

              <TextBlock Text="{Binding Description}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding HasDescription}" />

              <Border Classes="Разделитель" />

              <StackPanel Spacing="4">
                <TextBlock Text="Что восстановит" Classes="Рубрика" />

                <TextBlock Classes="Вторичный"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !HasRestores}"
                           Text="Ничего: этот отдых только проводит время. Что он делает, опишут правила события отдыха." />

                <ItemsControl ItemsSource="{Binding Restores}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RestRestoreRowViewModel">
                      <StackPanel Spacing="1" Margin="0,2">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Hint}"
                                   Classes="Вторичный"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HasHint}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </Border>

    </Grid>
  </DockPanel>

</UserControl>
