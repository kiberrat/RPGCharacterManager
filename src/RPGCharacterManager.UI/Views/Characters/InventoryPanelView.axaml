<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RPGCharacterManager.UI.ViewModels.Documents"
             xmlns:charactersVm="clr-namespace:RPGCharacterManager.UI.ViewModels.Characters"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
             x:Class="RPGCharacterManager.UI.Views.Characters.InventoryPanelView"
             x:DataType="charactersVm:SheetPanelViewModel">

  <!--
    Инвентарь остаётся основной рабочей областью. Мана и деньги открываются
    поверх него боковыми панелями и больше не отнимают вертикальное пространство.
  -->
  <Grid DataContext="{Binding Sheet}" x:DataType="vm:CharacterSheetViewModel">

    <ContentControl Content="{Binding Inventory}" Margin="46,0" />

    <!-- ===================== Левая ручка: мана ===================== -->
    <Button HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Width="40" Height="126"
            Padding="0"
            CornerRadius="0,12,12,0"
            IsVisible="{Binding !IsManaDrawerOpen}"
            ToolTip.Tip="Открыть панель маны"
            Command="{Binding ToggleManaDrawerCommand}">
      <TextBlock Text="Мана  ›"
                 FontWeight="SemiBold"
                 RenderTransformOrigin="50%,50%">
        <TextBlock.RenderTransform>
          <RotateTransform Angle="-90" />
        </TextBlock.RenderTransform>
      </TextBlock>
    </Button>

    <!-- ===================== Левая выдвижная панель ===================== -->
    <Border HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Width="420"
            Margin="0,0,0,8"
            Padding="0"
            CornerRadius="0,14,14,0"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,1,1,1"
            IsVisible="{Binding IsManaDrawerOpen}">
      <Grid ColumnDefinitions="*,42">
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16" Margin="22">
            <StackPanel Spacing="3">
              <TextBlock Text="Мана" Classes="Заголовок" />
              <TextBlock Text="Текущее значение и максимум сохраняются автоматически только у этого персонажа."
                         Classes="Вторичный" TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="ВложеннаяКарточка">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto,*">
                  <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Text="Текущая" Classes="Вторичный" />
                    <NumericUpDown Value="{Binding ManaCurrent}" Minimum="0"
                                   Maximum="999999999999" Increment="1" FormatString="0.##"
                                   ShowButtonSpinner="True" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="из" Classes="Вторичный"
                             Margin="10,24" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2" Spacing="5">
                    <TextBlock Text="Максимум" Classes="Вторичный" />
                    <NumericUpDown Value="{Binding ManaMaximum}" Minimum="0"
                                   Maximum="999999999999" Increment="1" FormatString="0.##"
                                   ShowButtonSpinner="True" Watermark="Без максимума" />
                  </StackPanel>
                </Grid>

                <WrapPanel Orientation="Horizontal">
                  <Button Content="−1" Classes="Тихая" Margin="0,0,6,6"
                          Command="{Binding DecreaseManaCommand}" />
                  <Button Content="+1" Classes="Тихая" Margin="0,0,6,6"
                          Command="{Binding IncreaseManaCommand}" />
                  <Button Content="Сбросить максимум" Classes="Тихая" Margin="0,0,6,6"
                          Command="{Binding ClearManaMaximumCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <TextBlock Text="{Binding ManaSaveStatus}" Classes="Вторичный" />
          </StackPanel>
        </ScrollViewer>

        <Button Grid.Column="1"
                Content="‹"
                FontSize="24"
                Padding="0"
                CornerRadius="0,13,13,0"
                ToolTip.Tip="Скрыть панель маны"
                Command="{Binding ToggleManaDrawerCommand}" />
      </Grid>
    </Border>

    <!-- ===================== Правая ручка: деньги ===================== -->
    <Button HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Width="40" Height="126"
            Padding="0"
            CornerRadius="12,0,0,12"
            IsVisible="{Binding !IsMoneyDrawerOpen}"
            ToolTip.Tip="Открыть панель денег"
            Command="{Binding ToggleMoneyDrawerCommand}">
      <TextBlock Text="‹  Деньги"
                 FontWeight="SemiBold"
                 RenderTransformOrigin="50%,50%">
        <TextBlock.RenderTransform>
          <RotateTransform Angle="90" />
        </TextBlock.RenderTransform>
      </TextBlock>
    </Button>

    <!-- ===================== Правая выдвижная панель ===================== -->
    <Border HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Width="500"
            Margin="0,0,0,8"
            Padding="0"
            CornerRadius="14,0,0,14"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1,1,0,1"
            IsVisible="{Binding IsMoneyDrawerOpen}">
      <Grid ColumnDefinitions="42,*">
        <Button Grid.Column="0"
                Content="›"
                FontSize="24"
                Padding="0"
                CornerRadius="13,0,0,13"
                ToolTip.Tip="Скрыть панель денег"
                Command="{Binding ToggleMoneyDrawerCommand}" />

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" Margin="22">
            <StackPanel Spacing="3">
              <TextBlock Text="Деньги" Classes="Заголовок" />
              <TextBlock Text="Любые валюты персонажа: монеты, жетоны и собственные единицы."
                         Classes="Вторичный" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="Деньги ещё не добавлены."
                       Classes="Вторичный" IsVisible="{Binding HasNoCurrencies}" />

            <ItemsControl ItemsSource="{Binding Currencies}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="charactersVm:CharacterCurrencyRowViewModel">
                  <Border Classes="ВложеннаяКарточка" Margin="0,0,0,8">
                    <StackPanel Spacing="8">
                      <TextBox Text="{Binding Name}" Watermark="Название валюты" />
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <NumericUpDown Grid.Column="0" Value="{Binding Amount}" Minimum="0"
                                       Maximum="999999999999" Increment="1" FormatString="0.##"
                                       ShowButtonSpinner="True" Margin="0,0,6,0" />
                        <Button Grid.Column="1" Content="Сохранить" Padding="10,5"
                                Command="{Binding $parent[ItemsControl].((vm:CharacterSheetViewModel)DataContext).SaveCurrencyCommand}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="2" Content="✕" Classes="Тихая" Padding="8,5" Margin="5,0,0,0"
                                ToolTip.Tip="Удалить валюту"
                                Command="{Binding $parent[ItemsControl].((vm:CharacterSheetViewModel)DataContext).DeleteCurrencyCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="ВложеннаяКарточка">
              <StackPanel Spacing="8">
                <TextBlock Text="Добавить валюту" Classes="Подзаголовок" />
                <TextBox Text="{Binding NewCurrencyName}" Watermark="Например, Золотые монеты" />
                <Grid ColumnDefinitions="*,Auto">
                  <NumericUpDown Grid.Column="0" Value="{Binding NewCurrencyAmount}" Minimum="0"
                                 Maximum="999999999999" Increment="1" FormatString="0.##"
                                 ShowButtonSpinner="True" Margin="0,0,8,0" />
                  <Button Grid.Column="1" Content="Добавить" Classes="Основная"
                          Command="{Binding AddCurrencyCommand}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
