<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RPGCharacterManager.UI.ViewModels.Documents"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
             x:Class="RPGCharacterManager.UI.Views.Documents.BackupsView"
             x:DataType="vm:BackupsViewModel">

  <Grid RowDefinitions="Auto,Auto,*" Margin="{DynamicResource AppDocumentPadding}">

    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="Резервные копии" Classes="Заголовок" />
      <TextBlock Classes="Вторичный" TextWrapping="Wrap"
                 Text="Копия содержит всю базу данных: персонажей, контент, игровые системы, кампании и журналы." />
      <SelectableTextBlock Classes="Вторичный"
                           Text="{Binding BackupsDirectory, StringFormat='Каталог хранения: {0}'}"
                           TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,16,0,12">
      <Button Content="Создать копию"
              Command="{Binding CreateCommand}"
              IsEnabled="{Binding !IsBusy}"
              Classes="Основная" />
      <Button Content="Восстановить из выбранной"
              Command="{Binding RestoreCommand}"
              IsEnabled="{Binding SelectedBackup, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <Button Content="Удалить устаревшие"
              Command="{Binding RemoveObsoleteCommand}" />
      <Button Content="Обновить список"
              Command="{Binding RefreshCommand}" />
    </StackPanel>

    <Border Grid.Row="2" Classes="Карточка" Padding="0">
      <Panel>
        <!-- Пустое состояние -->
        <StackPanel IsVisible="{Binding IsEmpty}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="6">
          <TextBlock Text="Резервных копий пока нет" Classes="Подзаголовок" HorizontalAlignment="Center" />
          <TextBlock Classes="Вторичный" HorizontalAlignment="Center"
                     Text="Нажмите «Создать копию», чтобы сохранить текущее состояние базы данных." />
        </StackPanel>

        <!--
          Список копий с виртуализацией: количество копий не ограничено,
          отрисовываются только видимые строки.
        -->
        <ListBox IsVisible="{Binding !IsEmpty}"
                 ItemsSource="{Binding Backups}"
                 SelectedItem="{Binding SelectedBackup}"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BackupListItem">
              <Grid ColumnDefinitions="200,120,140,*" Margin="4">
                <TextBlock Grid.Column="0" Text="{Binding CreatedAtText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding KindText}" Classes="Вторичный" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding Record.Comment}" Classes="Вторичный"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Panel>
    </Border>

  </Grid>

</UserControl>
