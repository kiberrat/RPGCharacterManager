<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RPGCharacterManager.UI.ViewModels.Documents"
             xmlns:stats="clr-namespace:RPGCharacterManager.Core.Abstractions.Statistics;assembly=RPGCharacterManager.Core"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="RPGCharacterManager.UI.Views.Documents.StatisticsView"
             x:DataType="vm:StatisticsViewModel">

  <UserControl.Styles>
    <!-- Показатель: крупное число с подписью под ним. -->
    <Style Selector="Border.Показатель">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="Margin" Value="0,0,10,10" />
    </Style>

    <Style Selector="Border.Показатель TextBlock.Число">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Шапка таблицы: подписи столбцов отделены от строк. -->
    <Style Selector="TextBlock.Столбец">
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Margin="{DynamicResource AppDocumentPadding}" Spacing="14">

      <StackPanel Spacing="4">
        <TextBlock Text="Статистика" Classes="Заголовок" />
        <TextBlock Classes="Вторичный"
                   TextWrapping="Wrap"
                   Text="Сводка по журналу: что бросали, чем били, что применяли и на что тратили. Отдельного учёта нет — очистка журнала обнуляет и эти числа." />
      </StackPanel>

      <!-- ===================== Отбор ===================== -->
      <Grid ColumnDefinitions="220,10,180,10,*,10,Auto">
        <ComboBox Grid.Column="0"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Characters}"
                  SelectedItem="{Binding SelectedCharacter}"
                  ToolTip.Tip="Считать по одному персонажу">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CharacterFilterOption">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <ComboBox Grid.Column="2"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Periods}"
                  SelectedItem="{Binding SelectedPeriod}"
                  ToolTip.Tip="Считать за последние дни">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="stats:StatisticsPeriod">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Column="4"
                   Text="{Binding Summary}"
                   Classes="Вторичный"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />

        <Button Grid.Column="6" Content="Обновить" Command="{Binding RefreshCommand}" />
      </Grid>
    </StackPanel>

    <Panel Margin="28,0,28,20">

      <StackPanel IsVisible="{Binding IsEmpty}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Spacing="6">
        <TextBlock Text="Считать нечего" Classes="Подзаголовок" HorizontalAlignment="Center" />
        <TextBlock Classes="Вторичный"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxWidth="480"
                   Text="За выбранный период событий не было. Бросьте кубик, атакуйте оружием, примените заклинание или измените ресурс — и статистика появится." />
      </StackPanel>

      <ScrollViewer IsVisible="{Binding !IsEmpty}">
        <StackPanel Spacing="14">

          <!-- ===================== Броски ===================== -->
          <Border Classes="Карточка" IsVisible="{Binding !Report.Rolls.IsEmpty}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="2">
                <TextBlock Text="Броски" Classes="Подзаголовок" />
                <TextBlock Classes="Вторичный"
                           TextWrapping="Wrap"
                           Text="Считается принятый итог: при преимуществе выражение вычисляется дважды, но бросок был один." />
              </StackPanel>

              <WrapPanel>
                <Border Classes="Показатель">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="Число" Text="{Binding Report.Rolls.Count, StringFormat={}{0:N0}}" />
                    <TextBlock Classes="Вторичный" Text="всего бросков" />
                  </StackPanel>
                </Border>

                <Border Classes="Показатель">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="Число" Text="{Binding Report.Rolls.Average, StringFormat={}{0:0.##}}" />
                    <TextBlock Classes="Вторичный" Text="средний итог" />
                  </StackPanel>
                </Border>

                <Border Classes="Показатель">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="Число" Text="{Binding Report.Rolls.Best, StringFormat={}{0:0.##}}" />
                    <TextBlock Classes="Вторичный" Text="лучший итог" />
                  </StackPanel>
                </Border>

                <Border Classes="Показатель">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="Число" Text="{Binding Report.Rolls.Worst, StringFormat={}{0:0.##}}" />
                    <TextBlock Classes="Вторичный" Text="худший итог" />
                  </StackPanel>
                </Border>

                <Border Classes="Показатель">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="Число" Text="{Binding Report.Rolls.Advantage, StringFormat={}{0:N0}}" />
                    <TextBlock Classes="Вторичный" Text="с преимуществом" />
                  </StackPanel>
                </Border>

                <Border Classes="Показатель">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="Число" Text="{Binding Report.Rolls.Disadvantage, StringFormat={}{0:N0}}" />
                    <TextBlock Classes="Вторичный" Text="с помехой" />
                  </StackPanel>
                </Border>
              </WrapPanel>

              <!-- Кости: среднее рядом с ожидаемым сразу показывает, везёт ли. -->
              <StackPanel Spacing="6" IsVisible="{Binding Report.Rolls.HasDice}">
                <Grid ColumnDefinitions="100,100,110,110,120,120">
                  <TextBlock Grid.Column="0" Classes="Столбец" Text="кость" />
                  <TextBlock Grid.Column="1" Classes="Столбец" Text="бросков" />
                  <TextBlock Grid.Column="2" Classes="Столбец" Text="среднее" />
                  <TextBlock Grid.Column="3" Classes="Столбец" Text="ожидаемо" />
                  <TextBlock Grid.Column="4" Classes="Столбец" Text="максимумов" />
                  <TextBlock Grid.Column="5" Classes="Столбец" Text="минимумов" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Report.Rolls.Dice}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="stats:DieStatistics">
                      <Grid ColumnDefinitions="100,100,110,110,120,120" Margin="0,3">
                        <TextBlock Grid.Column="0" Text="{Binding Notation}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Casts, StringFormat={}{0:N0}}" />
                        <TextBlock Grid.Column="2" Text="{Binding Average, StringFormat={}{0:0.##}}" Classes="Значение" />
                        <TextBlock Grid.Column="3" Text="{Binding Expected, StringFormat={}{0:0.##}}" Classes="Вторичный" />
                        <TextBlock Grid.Column="4">
                          <Run Text="{Binding Maximums, Mode=OneWay, StringFormat={}{0:N0}}" />
                          <Run Text="{Binding MaximumShare, Mode=OneWay, StringFormat=({0:P1})}" />
                        </TextBlock>
                        <TextBlock Grid.Column="5">
                          <Run Text="{Binding Minimums, Mode=OneWay, StringFormat={}{0:N0}}" />
                          <Run Text="{Binding MinimumShare, Mode=OneWay, StringFormat=({0:P1})}" />
                        </TextBlock>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- ===================== Криты и урон ===================== -->
          <Border Classes="Карточка" IsVisible="{Binding !Report.Attacks.IsEmpty}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="2">
                <TextBlock Text="Криты и урон" Classes="Подзаголовок" />
                <TextBlock Classes="Вторичный"
                           TextWrapping="Wrap"
                           Text="Критом считается то, что признало критом оружие: порог задаёте вы, приложение правил игры не знает." />
              </StackPanel>

              <WrapPanel>
                <Border Classes="Показатель">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="Число" Text="{Binding Report.Attacks.Attacks, StringFormat={}{0:N0}}" />
                    <TextBlock Classes="Вторичный" Text="всего атак" />
                  </StackPanel>
                </Border>

                <Border Classes="Показатель">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="Число" Text="{Binding Report.Attacks.Criticals, StringFormat={}{0:N0}}" />
                    <TextBlock Classes="Вторичный" Text="критов" />
                  </StackPanel>
                </Border>

                <Border Classes="Показатель">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="Число" Text="{Binding Report.Attacks.CriticalShare, StringFormat={}{0:P1}}" />
                    <TextBlock Classes="Вторичный" Text="доля критов" />
                  </StackPanel>
                </Border>

                <Border Classes="Показатель">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="Число" Text="{Binding Report.Attacks.Damage, StringFormat={}{0:0.##}}" />
                    <TextBlock Classes="Вторичный" Text="урона всего" />
                  </StackPanel>
                </Border>

                <Border Classes="Показатель">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="Число" Text="{Binding Report.Attacks.Average, StringFormat={}{0:0.##}}" />
                    <TextBlock Classes="Вторичный" Text="средний урон" />
                  </StackPanel>
                </Border>

                <Border Classes="Показатель">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="Число" Text="{Binding Report.Attacks.Best, StringFormat={}{0:0.##}}" />
                    <TextBlock Classes="Вторичный" Text="лучший удар" />
                  </StackPanel>
                </Border>
              </WrapPanel>

              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,90,90,90,100,100,100">
                  <TextBlock Grid.Column="0" Classes="Столбец" Text="оружие" />
                  <TextBlock Grid.Column="1" Classes="Столбец" Text="атак" />
                  <TextBlock Grid.Column="2" Classes="Столбец" Text="критов" />
                  <TextBlock Grid.Column="3" Classes="Столбец" Text="доля" />
                  <TextBlock Grid.Column="4" Classes="Столбец" Text="урон" />
                  <TextBlock Grid.Column="5" Classes="Столбец" Text="средний" />
                  <TextBlock Grid.Column="6" Classes="Столбец" Text="лучший" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Report.Attacks.Weapons}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="stats:WeaponStatistics">
                      <Grid ColumnDefinitions="*,90,90,90,100,100,100" Margin="0,3">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Attacks, StringFormat={}{0:N0}}" />
                        <TextBlock Grid.Column="2" Text="{Binding Criticals, StringFormat={}{0:N0}}" />
                        <TextBlock Grid.Column="3" Text="{Binding CriticalShare, StringFormat={}{0:P1}}" Classes="Вторичный" />
                        <TextBlock Grid.Column="4" Text="{Binding Damage, StringFormat={}{0:0.##}}" Classes="Значение" />
                        <TextBlock Grid.Column="5" Text="{Binding Average, StringFormat={}{0:0.##}}" />
                        <TextBlock Grid.Column="6" Text="{Binding Best, StringFormat={}{0:0.##}}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- ===================== Заклинания ===================== -->
          <Border Classes="Карточка" IsVisible="{Binding Report.HasSpells}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="2">
                <TextBlock Text="Заклинания" Classes="Подзаголовок" />
                <TextBlock Classes="Вторичный"
                           TextWrapping="Wrap"
                           Text="Одно и то же заклинание, применённое на разных уровнях, остаётся одним заклинанием." />
              </StackPanel>

              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,130">
                  <TextBlock Grid.Column="0" Classes="Столбец" Text="заклинание" />
                  <TextBlock Grid.Column="1" Classes="Столбец" Text="применений" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Report.Spells}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="stats:SpellUsage">
                      <Grid ColumnDefinitions="*,130" Margin="0,3">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Casts, StringFormat={}{0:N0}}"
                                   Classes="Значение" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- ===================== Ресурсы ===================== -->
          <Border Classes="Карточка" IsVisible="{Binding Report.HasResources}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="2">
                <TextBlock Text="Ресурсы" Classes="Подзаголовок" />
                <TextBlock Classes="Вторичный"
                           TextWrapping="Wrap"
                           Text="Потраченное и восстановленное показаны отдельно: ресурс, который потратили и вернули отдыхом, в сумме дал бы ноль." />
              </StackPanel>

              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,110,120,140,110">
                  <TextBlock Grid.Column="0" Classes="Столбец" Text="ресурс" />
                  <TextBlock Grid.Column="1" Classes="Столбец" Text="изменений" />
                  <TextBlock Grid.Column="2" Classes="Столбец" Text="потрачено" />
                  <TextBlock Grid.Column="3" Classes="Столбец" Text="восстановлено" />
                  <TextBlock Grid.Column="4" Classes="Столбец" Text="итог" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Report.Resources}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="stats:ResourceUsage">
                      <Grid ColumnDefinitions="*,110,120,140,110" Margin="0,3">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Changes, StringFormat={}{0:N0}}" />
                        <TextBlock Grid.Column="2" Text="{Binding Spent, StringFormat={}{0:0.##}}" />
                        <TextBlock Grid.Column="3" Text="{Binding Restored, StringFormat={}{0:0.##}}" />
                        <TextBlock Grid.Column="4" Text="{Binding Balance, StringFormat={}{0:+0.##;-0.##;0}}" Classes="Значение" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Panel>

  </DockPanel>

</UserControl>
