<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Слой представления: окна, представления, модели представления, темы и стили.

    Проект зависит только от Core и Shared. Все службы используются исключительно
    через интерфейсы ядра, поэтому слой представления не знает ни о базе данных,
    ни о конкретных реализациях инфраструктуры.
  -->

  <PropertyGroup>
    <RootNamespace>RPGCharacterManager.UI</RootNamespace>
    <Description>Пользовательский интерфейс приложения на Avalonia UI.</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RPGCharacterManager.Core\RPGCharacterManager.Core.csproj" />
    <ProjectReference Include="..\RPGCharacterManager.Shared\RPGCharacterManager.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
