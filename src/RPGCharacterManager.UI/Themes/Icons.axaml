<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Значки разделов, заданные векторными контурами.

    Контуры выбраны вместо шрифта значков намеренно: шрифт может отсутствовать
    в системе, и вместо значка пользователь увидит пустой прямоугольник. Векторный
    контур рисуется всегда и остаётся чётким при любом масштабе интерфейса.

    Все контуры описаны в квадрате 24 × 24 и рисуются штрихом, поэтому одинаково
    выглядят в светлой и тёмной теме.
  -->

  <!-- Обзор: панель показателей. -->
  <StreamGeometry x:Key="ЗначокОбзор">
    M4 13a8 8 0 0 1 16 0
    M4 13h2 M18 13h2 M12 5V3
    M12 13l4-3.5
  </StreamGeometry>

  <!-- Персонажи: фигура человека. -->
  <StreamGeometry x:Key="ЗначокПерсонажи">
    M12 11.5a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5z
    M4.5 20c0-3.6 3.4-5.5 7.5-5.5s7.5 1.9 7.5 5.5
  </StreamGeometry>

  <!-- Кампании: знамя игры, ведущейся мастером. -->
  <StreamGeometry x:Key="ЗначокКампании">
    M6 4v16
    M6 5h11l-2.5 3.5L17 12H6
  </StreamGeometry>

  <!-- Мастер: ширма мастера, за которой он ведёт игру. -->
  <StreamGeometry x:Key="ЗначокМастера">
    M3 19V8l4.5-3v14
    M7.5 8H12v11
    M12 5.5 16.5 8v11
    M16.5 8H21v11
    M2 19h20
  </StreamGeometry>

  <!-- Макросы: цепочка действий, идущих одно за другим. -->
  <StreamGeometry x:Key="ЗначокМакросов">
    M4 6h6
    M4 12h9
    M4 18h6
    M16.5 15.5 20 12l-3.5-3.5
  </StreamGeometry>

  <!-- Поиск: лупа. -->
  <StreamGeometry x:Key="ЗначокПоиска">
    M10.5 4a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13z
    M15.2 15.2 20.5 20.5
  </StreamGeometry>

  <!-- Интерфейс: панели, расставленные по окну. -->
  <StreamGeometry x:Key="ЗначокИнтерфейса">
    M3.5 4.5h17v15h-17z
    M3.5 9h17
    M10 9v10.5
  </StreamGeometry>

  <!-- Контент: слои игровых объектов. -->
  <StreamGeometry x:Key="ЗначокКонтент">
    M12 3.5 20.5 8 12 12.5 3.5 8z
    M3.5 12 12 16.5 20.5 12
    M3.5 16 12 20.5 20.5 16
  </StreamGeometry>

  <!-- Правила: регуляторы механики. -->
  <StreamGeometry x:Key="ЗначокПравила">
    M4 7h6 M14 7h6 M4 17h10 M18 17h2
    M12 4.5v5 M16 14.5v5
  </StreamGeometry>

  <!-- Резервные копии: круговая стрелка. -->
  <StreamGeometry x:Key="ЗначокКопии">
    M20 12a8 8 0 1 1-2.6-5.9
    M20 4v4h-4
  </StreamGeometry>

  <!-- Настройки: шестерня. -->
  <StreamGeometry x:Key="ЗначокНастройки">
    M12 15.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4z
    M12 2.8v2.6 M12 18.6v2.6 M21.2 12h-2.6 M5.4 12H2.8
    M18.5 5.5l-1.8 1.8 M7.3 16.7l-1.8 1.8
    M18.5 18.5l-1.8-1.8 M7.3 7.3 5.5 5.5
  </StreamGeometry>

  <!-- Обратная связь: конверт с сообщением. -->
  <StreamGeometry x:Key="ЗначокОбратнаяСвязь">
    M3.5 5.5h17v13h-17z
    M4 6l8 6.5L20 6
    M4 18l5.5-5 M20 18l-5.5-5
  </StreamGeometry>

  <!-- Мини-игры: небольшой игровой автомат. -->
  <StreamGeometry x:Key="ЗначокМиниИгры">
    M5 4.5h14v15H5z
    M8 8h8
    M9 13v4 M7 15h4
    M15.5 13.5v0.1 M17.5 15.5v0.1
  </StreamGeometry>

  <!-- Закрытие вкладки. -->
  <StreamGeometry x:Key="ЗначокЗакрыть">
    M6.5 6.5 17.5 17.5 M17.5 6.5 6.5 17.5
  </StreamGeometry>

  <!-- Скрытие и показ панели навигации. -->
  <StreamGeometry x:Key="ЗначокПанель">
    M4 5.5h16v13H4z M9.5 5.5v13
  </StreamGeometry>

  <!-- Журнал: страница со строками записей. -->
  <StreamGeometry x:Key="ЗначокЖурнал">
    M6 3.5h9l4 4v13H6z
    M15 3.5v4h4
    M9 12h7 M9 15.5h7 M9 8.5h3
  </StreamGeometry>

  <!-- AI: искра подсказки — большая и малая. -->
  <StreamGeometry x:Key="ЗначокAI">
    M10 3.5l1.7 4.3 4.3 1.7-4.3 1.7L10 15.5l-1.7-4.3L4 9.5l4.3-1.7z
    M17.5 14l0.9 2.1 2.1 0.9-2.1 0.9-0.9 2.1-0.9-2.1-2.1-0.9 2.1-0.9z
  </StreamGeometry>

  <!-- Расширения: деталь, встающая в общий узор. -->
  <StreamGeometry x:Key="ЗначокРасширений">
    M4 4.5h6v6H4z
    M14 4.5h6v6h-6z
    M4 14h6v6H4z
    M17 13.5v7 M13.5 17h7
  </StreamGeometry>

  <!-- Статистика: столбцы разной высоты. -->
  <StreamGeometry x:Key="ЗначокСтатистики">
    M4 20h16
    M7 20v-6 M12 20V6 M17 20v-9
  </StreamGeometry>

  <!-- Кубики: игральная кость с точками. -->
  <StreamGeometry x:Key="ЗначокКубики">
    M12 2.8 20 7v10l-8 4.2L4 17V7z
    M4 7l8 4.2L20 7 M12 11.2v10
    M8.4 9.1v0.1 M15.6 9.1v0.1
    M8 14.4v0.1 M16 14.4v0.1
  </StreamGeometry>

</ResourceDictionary>
