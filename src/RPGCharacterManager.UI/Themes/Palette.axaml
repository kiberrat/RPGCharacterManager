<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Цветовая палитра, типографика и метрики приложения.

    Документ 003_UI_UX.md требует спокойных нейтральных оттенков. Цвет несёт смысл
    только там, где он что-то означает: акцент — выбранный раздел и главное действие,
    жёлтый — предупреждение, красный — ошибка. Всё остальное построено на оттенках
    серого и на расстояниях, поэтому интерфейс остаётся тихим и читаемым.

    Акцентный цвет подставляется службой тем в ресурс AppAccentColor во время работы.
  -->

  <ResourceDictionary.ThemeDictionaries>

    <!-- ===================== Тёмная тема (используется по умолчанию) ===================== -->
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="AppWindowColor">#FF1C1C1E</Color>
      <Color x:Key="AppSidebarColor">#FF232326</Color>
      <Color x:Key="AppSurfaceColor">#FF2C2C2E</Color>
      <Color x:Key="AppSurfaceRaisedColor">#FF313134</Color>
      <Color x:Key="AppSurfaceHoverColor">#FF3A3A3D</Color>
      <Color x:Key="AppBorderColor">#FF3A3A3D</Color>
      <Color x:Key="AppSeparatorColor">#FF313134</Color>
      <Color x:Key="AppTextPrimaryColor">#FFF2F2F7</Color>
      <Color x:Key="AppTextSecondaryColor">#FF98989F</Color>
      <Color x:Key="AppTextDisabledColor">#FF636366</Color>
      <Color x:Key="AppSuccessColor">#FF30D158</Color>
      <Color x:Key="AppWarningColor">#FFFFD60A</Color>
      <Color x:Key="AppDangerColor">#FFFF453A</Color>

      <SolidColorBrush x:Key="AppWindowBrush" Color="{StaticResource AppWindowColor}" />
      <SolidColorBrush x:Key="AppSidebarBrush" Color="{StaticResource AppSidebarColor}" />
      <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
      <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="{StaticResource AppSurfaceRaisedColor}" />
      <SolidColorBrush x:Key="AppSurfaceHoverBrush" Color="{StaticResource AppSurfaceHoverColor}" />
      <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
      <SolidColorBrush x:Key="AppSeparatorBrush" Color="{StaticResource AppSeparatorColor}" />
      <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}" />
      <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource AppTextSecondaryColor}" />
      <SolidColorBrush x:Key="AppTextDisabledBrush" Color="{StaticResource AppTextDisabledColor}" />
      <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}" />
      <SolidColorBrush x:Key="AppWarningBrush" Color="{StaticResource AppWarningColor}" />
      <SolidColorBrush x:Key="AppDangerBrush" Color="{StaticResource AppDangerColor}" />

      <!-- Полупрозрачная подложка выделения: не спорит с акцентом и не рябит. -->
      <SolidColorBrush x:Key="AppSelectionBrush" Color="#FFFFFFFF" Opacity="0.10" />
    </ResourceDictionary>

    <!-- ===================== Светлая тема ===================== -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="AppWindowColor">#FFF6F6F8</Color>
      <Color x:Key="AppSidebarColor">#FFEDEDF1</Color>
      <Color x:Key="AppSurfaceColor">#FFFFFFFF</Color>
      <Color x:Key="AppSurfaceRaisedColor">#FFFFFFFF</Color>
      <Color x:Key="AppSurfaceHoverColor">#FFE6E6EB</Color>
      <Color x:Key="AppBorderColor">#FFDDDDE3</Color>
      <Color x:Key="AppSeparatorColor">#FFE6E6EB</Color>
      <Color x:Key="AppTextPrimaryColor">#FF1C1C1E</Color>
      <Color x:Key="AppTextSecondaryColor">#FF6C6C72</Color>
      <Color x:Key="AppTextDisabledColor">#FFAEAEB4</Color>
      <Color x:Key="AppSuccessColor">#FF1B8A3A</Color>
      <Color x:Key="AppWarningColor">#FF9A6300</Color>
      <Color x:Key="AppDangerColor">#FFC62F26</Color>

      <SolidColorBrush x:Key="AppWindowBrush" Color="{StaticResource AppWindowColor}" />
      <SolidColorBrush x:Key="AppSidebarBrush" Color="{StaticResource AppSidebarColor}" />
      <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
      <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="{StaticResource AppSurfaceRaisedColor}" />
      <SolidColorBrush x:Key="AppSurfaceHoverBrush" Color="{StaticResource AppSurfaceHoverColor}" />
      <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
      <SolidColorBrush x:Key="AppSeparatorBrush" Color="{StaticResource AppSeparatorColor}" />
      <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource AppTextPrimaryColor}" />
      <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource AppTextSecondaryColor}" />
      <SolidColorBrush x:Key="AppTextDisabledBrush" Color="{StaticResource AppTextDisabledColor}" />
      <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}" />
      <SolidColorBrush x:Key="AppWarningBrush" Color="{StaticResource AppWarningColor}" />
      <SolidColorBrush x:Key="AppDangerBrush" Color="{StaticResource AppDangerColor}" />

      <SolidColorBrush x:Key="AppSelectionBrush" Color="#FF000000" Opacity="0.07" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!--
    Акцентный цвет и производные от него кисти.
    Значение AppAccentColor заменяется службой тем при выборе акцента пользователем,
    поэтому все кисти ссылаются на него через DynamicResource.
  -->
  <Color x:Key="AppAccentColor">#FF0A84FF</Color>
  <Color x:Key="AppAccentHoverColor">#FF3D9BFF</Color>
  <Color x:Key="AppAccentPressedColor">#FF0060DF</Color>

  <SolidColorBrush x:Key="AppAccentBrush" Color="{DynamicResource AppAccentColor}" />
  <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{DynamicResource AppAccentHoverColor}" />
  <SolidColorBrush x:Key="AppAccentPressedBrush" Color="{DynamicResource AppAccentPressedColor}" />

  <!-- Приглушённый акцент для подложек: выделение не должно кричать. -->
  <SolidColorBrush x:Key="AppAccentSoftBrush" Color="{DynamicResource AppAccentColor}" Opacity="0.16" />

  <!--
    Шрифт. Системный шрифт Windows 11 ближе всего к тому, что задумано оформлением;
    перечисление задаёт запасные варианты, если основного шрифта в системе нет.
  -->
  <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, Inter, sans-serif</FontFamily>
  <FontFamily x:Key="AppFontFamilyDisplay">Segoe UI Variable Display, Segoe UI, Inter, sans-serif</FontFamily>

  <!-- Базовый размер шрифта. Заменяется службой тем в соответствии с настройками. -->
  <x:Double x:Key="AppFontSize">14</x:Double>
  <x:Double x:Key="AppFontSizeSmall">12</x:Double>
  <x:Double x:Key="AppFontSizeLarge">17</x:Double>
  <x:Double x:Key="AppFontSizeTitle">26</x:Double>

  <!--
    Метрики компоновки. Кратны четырём: единый шаг делает расстояния предсказуемыми,
    а разметку — свободной от произвольных чисел.
  -->
  <Thickness x:Key="AppPaddingSmall">8</Thickness>
  <Thickness x:Key="AppPaddingMedium">16</Thickness>
  <Thickness x:Key="AppPaddingLarge">24</Thickness>
  <Thickness x:Key="AppCardPadding">20</Thickness>
  <Thickness x:Key="AppDocumentPadding">28,24,28,24</Thickness>

  <CornerRadius x:Key="AppCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="AppCornerRadiusLarge">12</CornerRadius>
  <CornerRadius x:Key="AppCornerRadiusSmall">6</CornerRadius>

  <x:Double x:Key="AppControlHeight">34</x:Double>
  <x:Double x:Key="AppSidebarWidth">232</x:Double>
  <x:Double x:Key="AppDicePanelWidth">376</x:Double>
  <x:Double x:Key="AppIconSize">18</x:Double>

</ResourceDictionary>
