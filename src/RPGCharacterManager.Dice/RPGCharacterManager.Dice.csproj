<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Броски кубиков.

    Проект не содержит правил ни одной игры: бросок — это выражение, вычисленное
    единым движком формул. Преимущество, помеха, любимые броски и журнал одинаково
    работают и для «1d20 + Ловкость», и для «3d6 успехов».
  -->

  <PropertyGroup>
    <RootNamespace>RPGCharacterManager.Dice</RootNamespace>
    <Description>Броски кубиков: выражения, история и любимые броски.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RPGCharacterManager.Core\RPGCharacterManager.Core.csproj" />
    <ProjectReference Include="..\RPGCharacterManager.Database\RPGCharacterManager.Database.csproj" />
    <ProjectReference Include="..\RPGCharacterManager.Shared\RPGCharacterManager.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
