<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Импорт внешних документов.

    Каждый формат читает своё чтение, и все они приводят файл к тексту: дальше
    игровые объекты распознаёт помощник — один и тот же для книги правил,
    таблицы базы данных и набора записей JSON.
  -->

  <PropertyGroup>
    <RootNamespace>RPGCharacterManager.Import</RootNamespace>
    <Description>Импорт документов: PDF, DOCX, HTML, Markdown, TXT, JSON и SQLite.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RPGCharacterManager.Core\RPGCharacterManager.Core.csproj" />
    <ProjectReference Include="..\RPGCharacterManager.Shared\RPGCharacterManager.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />

    <!--
      Разбор PDF — единственное, чего нельзя сделать средствами платформы:
      формат хранит текст пофрагментно, со своими кодировками шрифтов и сжатием.
    -->
    <PackageReference Include="UglyToad.PdfPig" />

    <!-- Чтение таблиц из чужих баз SQLite тем же поставщиком, что и своя база. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />

    <!--
      Однобайтовые кодировки не входят в состав .NET: без них русский текстовый
      файл, сохранённый в Windows-1251, читался бы как набор вопросительных знаков.
    -->
    <PackageReference Include="System.Text.Encoding.CodePages" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RPGCharacterManager.Tests" />
  </ItemGroup>

</Project>
