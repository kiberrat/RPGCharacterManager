<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RPGCharacterManager.UI;assembly=RPGCharacterManager.UI"
             x:Class="RPGCharacterManager.App.App"
             RequestedThemeVariant="Dark">

  <!--
    Тёмная тема задана значением по умолчанию согласно 000_Главный_промпт.md.
    Фактический режим применяется службой оформления из пользовательских настроек
    сразу после запуска.
  -->

  <Application.DataTemplates>
    <ui:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://RPGCharacterManager.UI/Themes/Controls.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://RPGCharacterManager.UI/Themes/Palette.axaml" />
        <ResourceInclude Source="avares://RPGCharacterManager.UI/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
