<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Доступ к данным: контекст Entity Framework Core, конфигурации сущностей,
    миграции и репозитории.
  -->

  <PropertyGroup>
    <RootNamespace>RPGCharacterManager.Database</RootNamespace>
    <Description>Хранилище данных приложения на SQLite и Entity Framework Core.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RPGCharacterManager.Core\RPGCharacterManager.Core.csproj" />
    <ProjectReference Include="..\RPGCharacterManager.Shared\RPGCharacterManager.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />

    <!-- Требуется средствам dotnet ef для создания и применения миграций. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
