root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{xml,csproj,props,targets,axaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# --- Стиль языка ---
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_readonly_field = true:warning

# --- Именование в соответствии со STYLE_GUIDE ---
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# --- Обоснованные отступления от анализаторов ---

# CA1716: имена пространств имён Shared/Core совпадают с ключевыми словами Visual Basic.
# Приложение разрабатывается исключительно на C#, публичного API для других языков
# .NET не предоставляет, а имена проектов заданы документом 002_Архитектура.md.
dotnet_diagnostic.CA1716.severity = none

# CA1303: тексты сообщений интерфейса и журналов задаются на русском языке напрямую.
# Ресурсы локализации интерфейса хранятся в словарях Avalonia, а не в ResourceManager.
dotnet_diagnostic.CA1303.severity = none

# Миграции создаются средствами Entity Framework Core. Документ 004_База_данных.md
# запрещает ручное изменение схемы, поэтому править эти файлы нельзя, и правила
# оформления к ним не применяются.
[**/Migrations/*.cs]
generated_code = true
